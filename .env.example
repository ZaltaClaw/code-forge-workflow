# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL_ID=gpt-4o-mini

# OR Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://...openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Claude (via Claude Code CLI — `claude` must be installed & signed in)
# Provider routing: mixed (default), all-openai, all-claude, or per-role
#   e.g. "security_reviewer=claude,implementer=claude"
CODE_FORGE_PROVIDERS=mixed
CODE_FORGE_CLAUDE_MODEL=sonnet
