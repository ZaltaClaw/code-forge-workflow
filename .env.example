# OpenAI (default for non-review roles)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL_ID=gpt-4o-mini

# OR Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://...openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini

# --- Provider routing -----------------------------------------------------
# mixed (default)  → SecurityReviewer = Claude, everything else = OpenAI
# all-openai       → all five roles via OpenAI
# all-claude       → all five roles via Claude
# Per-role override: "security_reviewer=claude,implementer=claude"
CODE_FORGE_PROVIDERS=mixed

# --- Claude backend -------------------------------------------------------
# Option A: Anthropic public API (default — no extra config needed)
# ANTHROPIC_API_KEY=sk-ant-...
# CODE_FORGE_CLAUDE_MODEL=sonnet            # sonnet | opus | haiku

# Option B: Microsoft Foundry  (Claude on Azure)
# Run `az login` first; the Claude Code CLI uses your Entra ID by default.
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=<your-foundry-resource-name>      # e.g. roey-ai-foundry
# # OR full base URL:
# # ANTHROPIC_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
# # API-key auth (alternative to Entra ID):
# # ANTHROPIC_FOUNDRY_API_KEY=<project-api-key>
# CODE_FORGE_CLAUDE_MODEL=claude-sonnet-4-6   # must match a deployment name above
